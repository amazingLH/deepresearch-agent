# Copy to backend/.env. Use real model IDs available to your account.
APP_TOKEN=
LLM_BASE_URL=
AVAILABLE_MODELS=[{"model_id":"YOUR_MODEL_ID","display_name":"Research Model","icon":"Zap","icon_color":"yellow-400"}]
QUERY_GENERATOR_MODEL=YOUR_MODEL_ID
REFLECTION_MODEL=YOUR_MODEL_ID
ANSWER_MODEL=YOUR_MODEL_ID

EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=YOUR_EMBEDDING_MODEL_ID
EMBEDDING_DIM=1024

# Configure a DashScope application with the search capability used by the code.
DASHSCOPE_API_KEY=
MCP_APP_ID=

# Create the database first. Use your own local database credentials.
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379/0
MILVUS_URI=http://127.0.0.1:19530

NUMBER_OF_INITIAL_QUERIES=2
MAX_RESEARCH_LOOPS=2
WEB_SEARCH_MAX_QPS=12
KB_LIFECYCLE_MODE=freshness
RERANKER_KB_ENABLED=false
RERANKER_WEB_ENABLED=false
RERANKER_MODEL=gte-rerank
RERANKER_API_KEY=
RERANKER_TOP_K=5
RERANKER_MIN_SCORE=0.0
